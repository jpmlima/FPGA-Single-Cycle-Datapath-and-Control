# Target: Terasic DE2-115 (Cyclone IV E). No pin assignments yet:
# map clk/rst/pc/instr to board I/O before programming the device.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY cpu
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 19.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "19.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008

set_global_assignment -name VHDL_FILE ../rtl/cpu_pkg.vhd
set_global_assignment -name VHDL_FILE ../rtl/program_pkg.vhd
set_global_assignment -name VHDL_FILE ../rtl/mux2.vhd
set_global_assignment -name VHDL_FILE ../rtl/sign_extend.vhd
set_global_assignment -name VHDL_FILE ../rtl/program_counter.vhd
set_global_assignment -name VHDL_FILE ../rtl/reg_file.vhd
set_global_assignment -name VHDL_FILE ../rtl/imem.vhd
set_global_assignment -name VHDL_FILE ../rtl/dmem.vhd
set_global_assignment -name VHDL_FILE ../rtl/alu.vhd
set_global_assignment -name VHDL_FILE ../rtl/control_unit.vhd
set_global_assignment -name VHDL_FILE ../rtl/datapath.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu.vhd
